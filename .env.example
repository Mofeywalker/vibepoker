# PartyKit host (local development)
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Optional: Comma-separated origin allowlist for the PartyKit Worker.
# When empty/unset, all http(s) origins are permitted (fine for local dev).
# Set this in production to prevent cross-site WebSocket hijacking.
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
